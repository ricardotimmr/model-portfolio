# Pooled Neon connection used by the application at runtime.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Direct Neon connection preferred by migration tooling.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/database?sslmode=require"

# Vercel Blob read/write credential. Keep server-side and never expose publicly.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_store_id_your_secret"
